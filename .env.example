PORT=3000
# Docker host port; the container continues to listen on PORT=3000.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
DATA_DIR=./data
MCP_MASTER_KEY_FILE=./secrets/mcp_master_key.txt
# For local Node development, use http://localhost:3000 instead.
PUBLIC_URL=http://localhost:3001
# Required only for initial administrator creation; set a long random value.
SETUP_TOKEN=
QUERY_TIMEOUT_SECONDS=30
DDL_TIMEOUT_SECONDS=60
TRANSACTION_TIMEOUT_SECONDS=300
# Idle expiry for stateful sessions opened with db_open_session (seconds).
DB_SESSION_IDLE_TTL_SECONDS=1800
# Set to 0/false to force this process read-only, even over the saved policy.
# Any other value never widens the saved policy.
DB_MCP_READ_ONLY=
