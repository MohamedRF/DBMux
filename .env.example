PORT=3000
# Docker host port; the container continues to listen on PORT=3000.
HOST_PORT=3001
DATA_DIR=./data
MCP_MASTER_KEY_FILE=./secrets/mcp_master_key.txt
# For local Node development, use http://localhost:3000 instead.
PUBLIC_URL=http://localhost:3001
# Required only for initial administrator creation; set a long random value.
SETUP_TOKEN=
QUERY_TIMEOUT_SECONDS=30
DDL_TIMEOUT_SECONDS=60
TRANSACTION_TIMEOUT_SECONDS=300
