{
  "name": "dbmux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dbmcp": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "express": "^5.1.0",
    "oracledb": "^6.10.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/oracledb": "^6.10.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
